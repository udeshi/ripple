DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ripple?schema=public"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# STORAGE_PROVIDER: "local" (default) or "cloudinary"
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# MAIL_PROVIDER: "console" (default, logs the link) or "smtp"
MAIL_PROVIDER="console"
MAIL_FROM="Ripple <no-reply@ripple.app>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# Stream Chat (https://getstream.io) — free tier
STREAM_API_KEY=""
STREAM_API_SECRET=""

# Optional: promotes this user to ADMIN when `npm run db:seed` runs.
ADMIN_EMAIL=""
